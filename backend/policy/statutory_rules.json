  "rules": [
    {
      "rule_id": "SC-ST-QUOTA-SC",
      "clause_title": "Scheduled Caste Area Mandatory Allocation Quota",
      "legal_source": "MPLADS Guidelines 2023, Chapter 2, Clause 2.5",
      "version": "v2023.1",
      "effective_from": "2023-04-01",
      "effective_to": null,
      "quota_percentage": 15.0,
      "description": "At least 15% of MPLADS funds sanctioned by an MP must be allocated towards areas inhabited by Scheduled Caste (SC) population.",
      "severity": "HIGH",
      "penalty_points": 25,
      "evaluation_scope": "MP_ANNUAL_SANCTION"
    },
    {
      "rule_id": "SC-ST-QUOTA-ST",
      "clause_title": "Scheduled Tribe Area Mandatory Allocation Quota",
      "legal_source": "MPLADS Guidelines 2023, Chapter 2, Clause 2.5",
      "version": "v2023.1",
      "effective_from": "2023-04-01",
      "effective_to": null,
      "quota_percentage": 7.5,
      "description": "At least 7.5% of MPLADS funds sanctioned by an MP must be allocated towards areas inhabited by Scheduled Tribe (ST) population.",
      "severity": "HIGH",
      "penalty_points": 25,
      "evaluation_scope": "MP_ANNUAL_SANCTION"
    },
    {
      "rule_id": "NEG-LIST-01",
      "clause_title": "Ineligible: Places of Worship and Religious Structures",
      "legal_source": "MPLADS Guidelines 2023, Annexure-I (Negative List), Item 1",
      "version": "v2023.1",
      "effective_from": "2023-04-01",
      "effective_to": null,
      "prohibited_keywords": ["temple", "mandir", "mosque", "masjid", "church", "gurudwara", "ashram", "shrine", "religious", "math", "dargah", "puja pandal", "idols"],
      "description": "Works within or belonging to places of religious worship or on land owned by religious bodies are strictly prohibited.",
      "severity": "CRITICAL",
      "penalty_points": 40,
      "evaluation_scope": "INDIVIDUAL_WORK"
    },
    {
      "rule_id": "NEG-LIST-02",
      "clause_title": "Ineligible: Private Trusts, Commercial Entities & Pecuniary Gain",
      "legal_source": "MPLADS Guidelines 2023, Annexure-I (Negative List), Item 4",
      "version": "v2023.1",
      "effective_from": "2023-04-01",
      "effective_to": null,
      "prohibited_keywords": ["pvt ltd", "private limited", "commercial complex", "shopping center", "private society", "family trust", "private club", "resort"],
      "description": "Works on assets belonging to private commercial entities, private trusts, or for private pecuniary benefit are inadmissible.",
      "severity": "CRITICAL",
      "penalty_points": 35,
      "evaluation_scope": "INDIVIDUAL_WORK"
    },
    {
      "rule_id": "NEG-LIST-03",
      "clause_title": "Ineligible: Land Acquisition / Compensation",
      "legal_source": "MPLADS Guidelines 2023, Annexure-I (Negative List), Item 2",
      "version": "v2023.1",
      "effective_from": "2023-04-01",
      "effective_to": null,
      "prohibited_keywords": ["land acquisition", "land compensation", "purchase of land", "reimbursement for land"],
      "description": "Acquisition of land or payment of compensation for land is strictly prohibited under MPLADS funds.",
      "severity": "CRITICAL",
      "penalty_points": 35,
      "evaluation_scope": "INDIVIDUAL_WORK"
    },
    {
      "rule_id": "NEG-LIST-04",
      "clause_title": "Ineligible: Consumables, Revenue Expenditure & Inventory",
      "legal_source": "MPLADS Guidelines 2023, Annexure-I (Negative List), Item 5 & GFR Rule 130",
      "version": "v2023.1",
      "effective_from": "2023-04-01",
      "effective_to": null,
      "prohibited_keywords": ["salaries", "stationery", "fuel", "refreshment", "contingency honorarium", "maintenance recurring", "office rent", "wages"],
      "description": "Creation of recurring revenue liabilities, payment of wages/salaries, or purchase of consumables is not permitted.",
      "severity": "HIGH",
      "penalty_points": 30,
      "evaluation_scope": "INDIVIDUAL_WORK"
    },
    {
      "rule_id": "NEG-LIST-05",
      "clause_title": "Ineligible: Statues, Memorials and Monuments",
      "legal_source": "MPLADS Guidelines 2023, Annexure-I (Negative List), Item 3",
      "version": "v2023.1",
      "effective_from": "2023-04-01",
      "effective_to": null,
      "prohibited_keywords": ["statue", "memorial", "monument", "smriti", "samadhi", "bust", "portrait"],
      "description": "Construction of statues, memorials, or monuments of individuals is inadmissible under MPLADS.",
      "severity": "HIGH",
      "penalty_points": 30,
      "evaluation_scope": "INDIVIDUAL_WORK"
    },
    {
      "rule_id": "NEG-LIST-06",
      "clause_title": "Ineligible: Residential Buildings for Government Officials",
      "legal_source": "MPLADS Guidelines 2023, Annexure-I (Negative List), Item 6",
      "version": "v2023.1",
      "effective_from": "2023-04-01",
      "effective_to": null,
      "prohibited_keywords": ["staff quarters", "bungalow", "officer residence", "guest house private", "rest house official"],
      "description": "Construction of residential buildings for Central or State Government officials is barred.",
      "severity": "MEDIUM",
      "penalty_points": 25,
      "evaluation_scope": "INDIVIDUAL_WORK"
    },
    {
      "rule_id": "NEG-LIST-07",
      "clause_title": "Ineligible: Purchase of Vehicles or Aircraft",
      "legal_source": "MPLADS Guidelines 2023, Annexure-I (Negative List), Item 7",
      "version": "v2023.1",
      "effective_from": "2023-04-01",
      "effective_to": null,
      "prohibited_keywords": ["car", "suv", "vehicle purchase", "jeep", "bus official", "boat motorized", "helicopter"],
      "description": "Purchase of vehicles or transport aircraft is inadmissible, except specialized mobile ambulances/hearses explicitly permissible under public health.",
      "severity": "HIGH",
      "penalty_points": 30,
      "evaluation_scope": "INDIVIDUAL_WORK"
    },
    {
      "rule_id": "PACE-CAP",
      "clause_title": "Ministry of Finance Expenditure Pacing Caps (March Rush Prevention)",
      "legal_source": "Ministry of Finance OM F.No.1(14)-B(AC)/2017 & GFR 2017 Rule 62",
      "version": "v2017.1",
      "effective_from": "2017-03-07",
      "effective_to": null,
      "q4_max_percentage": 33.0,
      "march_max_percentage": 15.0,
      "description": "Not more than 33% of the annual budget allocation shall be sanctioned in the last quarter (Jan-Mar), and not more than 15% in the month of March alone.",
      "severity": "MEDIUM",
      "penalty_points": 20,
      "evaluation_scope": "DISTRICT_ANNUAL_PACING"
    },
    {
      "rule_id": "COMP-DEADLINE",
      "clause_title": "Statutory Work Completion Time-Limit",
      "legal_source": "MPLADS Guidelines 2023, Chapter 3, Clause 3.12",
      "version": "v2023.1",
      "effective_from": "2023-04-01",
      "effective_to": null,
      "standard_duration_months": 12,
      "description": "All sanctioned works must be completed within 12 months from the date of financial sanction, unless explicit extension is recorded.",
      "severity": "MEDIUM",
      "penalty_points": 15,
      "evaluation_scope": "INDIVIDUAL_WORK"
    },
    {
      "rule_id": "TRUST-CAP",
      "clause_title": "Lifetime Assistance Cap for Registered Societies & Trusts",
      "legal_source": "MPLADS Guidelines 2023, Chapter 2, Clause 2.8",
      "version": "v2023.1",
      "effective_from": "2023-04-01",
      "effective_to": null,
      "max_lifetime_inr": 10000000.00,
      "description": "Not more than ₹1.00 Crore can be sanctioned from MPLADS in the lifetime of any single eligible registered trust/society.",
      "severity": "HIGH",
      "penalty_points": 25,
      "evaluation_scope": "TRUST_LIFETIME_AGGREGATE"
    },
    {
      "rule_id": "ADMIN-CAP",
      "clause_title": "Statutory Administrative Expenses Ceiling",
      "legal_source": "MPLADS Guidelines 2023, Chapter 4, Clause 4.1",
      "version": "v2023.1",
      "effective_from": "2023-04-01",
      "effective_to": null,
      "max_admin_percentage": 2.0,
      "description": "Administrative charges for District Authorities and Implementing Agencies shall not exceed 2% of the sanctioned work amount.",
      "severity": "MEDIUM",
      "penalty_points": 15,
      "evaluation_scope": "DISTRICT_ADMIN_EXPENSES"
    }
