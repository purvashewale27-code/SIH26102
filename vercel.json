{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/{data/mospi/precomputed_*.json,data/mospi/states.json,data/mospi/constituencies.json,data/mospi/mps*.json,data/cpwd/**,ml/**,policy/**,rules/**,services/**,server.js}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/frontend/$1"
    }
  ]
}
